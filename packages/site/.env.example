# Optional destinations for the Splic.co marketing site.
# All values are optional — when unset, the site shows an honest
# "in development" state instead of linking to a destination.

# Public download URL for the desktop app (e.g. a release page).
# When set, primary CTAs link here instead of the in-page download section.
NEXT_PUBLIC_DOWNLOAD_URL=

# Early-access or waitlist destination.
NEXT_PUBLIC_WAITLIST_URL=

# Documentation site URL (shown in the footer when set).
NEXT_PUBLIC_DOCS_URL=

# Contact email address (adds a "Contact" footer link when set).
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional Console URL override. When unset, the navbar links to the in-repo
# Console preview at /console. Set this only when a hosted Console app replaces
# the preview.
NEXT_PUBLIC_CONSOLE_URL=
