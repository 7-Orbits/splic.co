DATABASE_URL="postgres://postgres:postgres@localhost:5432/splic"
PORT=3010

# Allowed frontend origin(s) for CORS and post-login redirect resolution.
# Comma-separated. Must include the Console origin(s) (local dev and production).
SITE_ORIGIN=http://localhost:3000,https://splic.com

# Public origin of this Gateway; the OAuth callback is
# {GATEWAY_PUBLIC_URL}/auth/google/callback and must be registered verbatim
# in Google Cloud Console (Authorized redirect URIs).
GATEWAY_PUBLIC_URL=http://localhost:3010

GOOGLE_CLIENT_ID=demo-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=demo-google-client-secret

# Session cookie lifetime in seconds (default 604800 = 7 days).
# AUTH_SESSION_TTL_SECONDS=604800

# Optional cookie Domain shared by site + Gateway hosts (e.g. .splic.com);
# host-only by default, which already covers localhost across ports in dev.
# AUTH_COOKIE_DOMAIN=

# lax (default) | strict | none (none forces Secure; HTTPS deployments only).
# AUTH_COOKIE_SAMESITE=lax

# Deferred: Microsoft OAuth is not implemented; these are placeholders and
# are NOT required for the Gateway to start.
MICROSOFT_CLIENT_ID=demo-microsoft-client-id
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=demo-microsoft-client-secret
